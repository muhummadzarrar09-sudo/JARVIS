APP_NAME=JARVIS Local
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

DATA_DIR=./data
MODEL_DIR=./data/models
MEMORY_DB_PATH=./data/memory/jarvis.db
AUDIT_LOG_PATH=./data/logs/audit.jsonl

DEFAULT_FAST_MODEL=Qwen2.5-3B-Instruct-Q4_K_M.gguf
DEFAULT_MAIN_MODEL=Qwen2.5-7B-Instruct-Q4_K_M.gguf
DEFAULT_MODEL_PROVIDER=mock

ALLOW_SHELL_TOOL=true
SHELL_TIMEOUT_SECONDS=20
ALLOW_FILE_TOOL=true
WORKSPACE_ROOT=.
MAX_FILE_READ_BYTES=200000
ALLOW_BROWSER_TOOL=true
BROWSER_HEADLESS=false
BROWSER_DEFAULT_TIMEOUT_MS=15000
BROWSER_ARTIFACT_DIR=./data/browser
